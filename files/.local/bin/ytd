#!/bin/sh
set -eu

url="${1:?usage: ytd URL}"

ytdl() {
  yt-dlp \
    -x -f "bestaudio[ext=m4a]/bestaudio" \
    --embed-metadata --embed-thumbnail --convert-thumbnails jpg \
    --restrict-filenames \
    --min-sleep-interval 5 --max-sleep-interval 15 --sleep-requests 2 \
    --ppa "ThumbnailsConvertor+ffmpeg_o:-vf crop='min(iw\,ih):min(iw\,ih)'" \
    --parse-metadata "%(playlist_uploader,uploader)s:%(album_artist)s" \
    --parse-metadata "%(track_number,playlist_index)s:%(meta_track_number)s" \
    --replace-in-metadata album_artist " - Topic$" "" \
    --parse-metadata "%(meta_track_number)s:%(track_number)s" \
    "$@"
}

count=$(yt-dlp --flat-playlist -I 1 --print "%(playlist_count|)s" "$url" 2>/dev/null | head -n1 || true)

if [ "${count:-0}" -gt 1 ]; then
  echo "Album/playlist detected ($count tracks)"
  ytdl \
    -o "%(album_artist,artist,uploader)s/%(album,playlist_title)s/%(track_number,playlist_index)02d-%(track,title)s.%(ext)s" \
    "$url"
else
  echo "Single track detected"
  ytdl --no-playlist \
    -o "%(album_artist,artist,uploader)s/%(track,title)s.%(ext)s" \
    "$url"
fi
