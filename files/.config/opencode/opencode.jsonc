{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "policies": [
      {
          "action": "tool.use",
          "resource": "shell:docker *",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:podman *",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:docker-compose *",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:podman-compose *",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:rm */gnu/store*",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:rmdir */gnu/store*",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:mv */gnu/store*",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:chmod */gnu/store*",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:chown */gnu/store*",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:chgrp */gnu/store*",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:truncate */gnu/store*",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:shred */gnu/store*",
          "effect": "deny"
      },
      {
          "action": "tool.use",
          "resource": "shell:dd *=/gnu/store*",
          "effect": "deny"
      }
  ],
  "permissions": [
    // Ask before touching anything outside the active project location ...
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    // ... except /tmp (read-write) and /gnu/store (read-only)
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/gnu/store/*", "effect": "allow" },

    // File tool baseline (V1 read/glob/grep allows)
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // /tmp: full read-write
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },

    // /gnu/store: read-only
    { "action": "read", "resource": "/gnu/store/*", "effect": "allow" },
    { "action": "edit", "resource": "/gnu/store/*", "effect": "deny" },
  ],
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "dunnet": {
      "type": "local",
      "command": ["python3", "-u", "/home/nick/git/dunnet-mcp/mcp-server.py"],
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ollama",
      "options": {
        "baseURL": "http://llama.gnosis.arpa/v1"
      },
      "models": {
        "qwen3:4b": {
          "name": "Qwen 3 4B",
          "tool_call": true,
          "limit": { "context": 32000, "output": 4096 }
        },
        "qwen3.5:2b": {
          "name": "Qwen 3.5 2B",
          "tool_call": true,
          "limit": { "context": 32000, "output": 4096 }
        },
        "qwen3.5:0.8b": {
          "name": "Qwen 3.5 0.8B",
          "tool_call": true,
          "limit": { "context": 16000, "output": 2048 }
        },
        "llama3.2:1b": {
          "name": "Llama 3.2 1B",
          "tool_call": true,
          "limit": { "context": 16000, "output": 2048 }
        },
        "gemma4:e2b": {
          "name": "Gemma 4 5.1B",
          "tool_call": true,
          "limit": { "context": 32000, "output": 4096 }
        }
      }
    }
  }
}
